# Copy to .env. Everything here is optional — without it the scout still
# serves Google-OAuth scans (access tokens arrive per-request from the app)
# and the bundled demo mailbox.

# Lets the scout refresh expired Google access tokens mid-scan. Use the same
# OAuth client the Supabase Google provider is configured with
# (Google Cloud console -> APIs & Services -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev convenience: a fixed IMAP inbox for credential-less GET /scan.
# Gmail: enable 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it here.
#IMAP_HOST=imap.gmail.com
#IMAP_USER=you@gmail.com
#IMAP_PASSWORD=abcd efgh ijkl mnop
